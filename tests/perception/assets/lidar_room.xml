<mujoco model="lidar_room">
  <!-- The lidar gate's scene: the public G1 in a 6 x 5 m room with one of
       every geom type a lidar can meet (box, cylinder, capsule, sphere,
       ellipsoid, heightfield, and the G1's own meshes), plus one INVISIBLE
       box (alpha 0) standing in the beam's way, which `mj_ray` skips — and which
       collides with nothing, so it is a decoration and not an obstacle (an
       invisible COLLIDING geom would be glass: real, and unseeable by rays).

       ⚠ THE WALLS ARE 2.5 m TALL ON PURPOSE. A head lidar sits ~1.3 m up and
       sweeps upward; the demo room's 1 m walls (sized for its cameras) would
       let it see straight over them into nothing. There is NO CEILING, so
       the upward beams (the MID-360's band reaches +52 deg) leave the room and
       the no-return branch is compared too. -->
  <compiler angle="radian"/>
  <option timestep="0.005"/>
  <asset>
    <model name="unitree_g1" file="../../../noeira/envs/robots/assets/unitree_g1.xml"/>
    <hfield name="rug" file="../../physics3d/assets/hf_8x8.bin" size="0.8 0.6 0.04 0.01"/>
  </asset>
  <worldbody>
    <frame pos="0 0 0">
      <attach model="unitree_g1" prefix="robot_"/>
    </frame>
    <body name="room">
      <geom name="wall_n" type="box" size="3.1 0.05 1.25" pos="0 2.55 1.25"/>
      <geom name="wall_s" type="box" size="3.1 0.05 1.25" pos="0 -2.55 1.25"/>
      <geom name="wall_w" type="box" size="0.05 2.5 1.25" pos="-3.05 0 1.25"/>
      <geom name="wall_e" type="box" size="0.05 2.5 1.25" pos="3.05 0 1.25"/>
      <geom name="table_top" type="box" size="0.6 0.4 0.02" pos="-1.8 1.5 0.74"/>
      <geom name="table_leg1" type="box" size="0.03 0.03 0.36" pos="-1.25 1.85 0.36"/>
      <geom name="table_leg2" type="box" size="0.03 0.03 0.36" pos="-1.25 1.15 0.36"/>
      <geom name="table_leg3" type="box" size="0.03 0.03 0.36" pos="-2.35 1.85 0.36"/>
      <geom name="table_leg4" type="box" size="0.03 0.03 0.36" pos="-2.35 1.15 0.36"/>
      <geom name="cabinet" type="box" size="0.35 0.3 0.9" pos="2.5 1.9 0.9" euler="0 0 0.3"/>
      <geom name="bin" type="cylinder" size="0.2 0.3" pos="1.6 -1.8 0.3"/>
      <geom name="post" type="capsule" size="0.06 0.6" pos="-0.9 -1.2 0.66"/>
      <geom name="lamp_arm" type="capsule" size="0.03 0.4" pos="2.2 -0.6 1.5" euler="0.9 0.2 0"/>
      <geom name="ball" type="sphere" size="0.15" pos="0.9 1.2 0.15"/>
      <geom name="pouf" type="ellipsoid" size="0.35 0.25 0.2" pos="-1.9 -1.6 0.2" euler="0 0 0.5"/>
      <geom name="rug" type="hfield" hfield="rug" pos="1.2 0.4 0.0"/>
      <geom name="ghost" type="box" size="0.05 0.6 0.6" pos="1.0 0 1.0" rgba="1 0 0 0" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
