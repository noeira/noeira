# Training artifacts (large; not source)
checkpoints/

# Run directories (`core/run.mojo`). One per execution: run.kv, metrics.csv and
# checkpoints/.
#
# The P0 run root, used by a driver whose project does not exist locally.
/runs/

# Project directories (`core/project.mojo`). ⚠⚠ ALL OF IT, DEFINITION INCLUDED.
# Projects are PRIVATE and are created without touching the core repository,
# so none of `projects/` belongs in it. The definition (`project.kv`,
# calibration, task files, policy records) reaches another machine through the
# platform instead: `project-push <name>` / `project-pull <name>`
# (`core/project_sync.mojo`). This revises PROJECT_LAYER_PLAN.md §4.
projects/
*.mp4
# …except the docs site's demo videos: small, re-encoded by
# docs-site/scripts/build-media.mjs (or by hand), and the site needs them.
!docs-site/public/media/*.mp4
# ...except the vision gate's INPUT. `*.mp4` above is for renderer recordings;
# this 3 KB file is a committed test fixture, and without it a fresh checkout
# cannot run tests/vision/test_opencv_shim.mojo at all.
!tests/fixtures/vision/*.mp4
# Rendered media dropped at the repo root by demo/diagnostic scripts
# (root-anchored on purpose - tracked images elsewhere stay addable)
/*.png
/*.gif

# Viewer captures. The 3D renderer writes `screenshot_<N>.jpg` and
# `recording_<N>.mp4` into the CURRENT WORKING DIRECTORY, and the counter
# restarts at 0 on every run - so a second session silently overwrites the
# first, and any that were tracked churn `git status` on every capture.
# (screenshot_0.jpg and screenshot_1.jpg WERE tracked until this rule landed.)
#
# NOT root-anchored, unlike the rule above: these names are generated by the
# renderer and carry a counter, so they will not collide with a real asset
# wherever a viewer happens to be run from.
screenshot_*.jpg
screenshot_*.png
recording_*.mp4
recording_*.gif

# Vendored C/C++ sources fetched by build scripts (scripts/build_imgui.sh
# clones Dear ImGui here on first use). Source, not ours; re-fetchable.
third_party/
# The Dear ImGui shim built from noeira/render/imgui/imgui_shim.cpp. The
# .cpp IS tracked; the binary is per-platform and rebuilt by
# `pixi run build-imgui`.
*.dylib
# The serial shim built from noeira/io/serial/native/nra_serial.c. The .c IS
# tracked; both binaries are per-platform and rebuilt by
# `pixi run build-serial`.
noeira/io/serial/*.so
noeira/io/serial/*.o
fb_walker_d128.ckpt

# The HTTP shim built from noeira/io/native/nra_http.c. The .c IS tracked;
# the binary is per-platform (it links the pixi env's libcurl by rpath) and is
# rebuilt by `pixi run build-http`.
noeira/io/libnra_http.so

# qhull shim (built by `pixi run build-qhull`, not tracked)
noeira/physics3d/collision/libnra_qhull.dylib
noeira/physics3d/collision/libnra_qhull.so

# Generated printable markers and other local scratch output
# (tools/vision/make_printable_marker.py writes here).
scratch/

# G1 rung: the LAFAN1 TrajectoryStore (1.7 GB, examples/g1/lafan_import.mojo) and
# the reference's own dump it is gated against (tools/g1/lafan_to_store.py)
/lafan_g1_50hz.h5
/lafan_g1_50hz_oracle.h5

# LIBERO asset pack, materialised by `pixi run assets-pull libero` (assets.kv)
noeira/envs/libero/assets/
build/packs/

# the BFM-Zero pool sidecar: 70 MB of encoded B rows, rebuilt in seconds by
# `examples/g1/bfm_zero_spec_probe.mojo --emit-pool` from the checkpoint and
# the store. Derived, and larger than anything that belongs in git.
g1_pool.bin

# reward-spec candidates the voice demo appends to when it runs a novel latent
# (`g1_spec_record`). An operational log, not a source: the bank records each
# promoted row's own terms, so nothing is lost by regenerating it.
g1_spec_candidates.txt
