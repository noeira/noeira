<mujoco model="depth_bench">
  <!-- The depth error-model bench: a fronto-parallel WALL whose front face is
       at x = 3 (a constant planar depth for a level camera at the origin), a
       thin PILLAR whose front face is at x = 1 (y in [-0.1, 0.1]), and the
       floor. Analytic answers: planar depth 3 on the wall, the stereo shadow
       band fx * baseline * (1/1 - 1/3) px wide on the pillar's LEFT, the
       floor's incidence cos = h / ray length. -->
  <compiler angle="radian"/>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05"/>
    <geom name="wall" type="box" size="0.05 6 3" pos="3.05 0 1"/>
    <geom name="pillar" type="box" size="0.01 0.1 1.5" pos="1.01 0 1"/>
  </worldbody>
</mujoco>
