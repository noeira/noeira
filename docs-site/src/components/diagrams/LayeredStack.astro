---
/**
 * LayeredStack — the layers of noeira, and which of them are general-purpose.
 *
 * The claim worth drawing is the one the page makes: the bottom layers are
 * libraries in their own right. `nn` imports no agent, `physics3d` no
 * learning code (it uses `nn`'s Tensor storage, not its networks), and the
 * robot and vision packages import almost nothing — so someone can take the
 * physics engine, the network framework or the servo driver without taking an
 * algorithm. The bottom row splits in two because simulation and the real
 * world are the two things a policy is run against, side by side.
 */

const LAYERS = [
	{
		name: 'Drivers and deployment',
		what: 'own the loops — training, recording, the robot',
		pkg: 'deep_agents/training · core/run',
		tone: 'spark',
	},
	{
		name: 'Learning',
		what: 'RL, world models, imitation, VLAs, planners',
		pkg: 'agents · deep_agents · planners',
		tone: 'spark',
	},
	{
		name: 'Deep learning and data',
		what: 'Module / Param, composed VJPs, datasets, native I/O',
		pkg: 'nn · data · io',
		tone: 'cyan',
	},
];

const ROW_H = 62;
const ROW_Y = (i: number) => 92 + i * (ROW_H + 8);
const BOTTOM_Y = ROW_Y(3);

/** The standalone bracket spans the three general-purpose rows. */
const BRACKET_TOP = ROW_Y(2);
const BRACKET_BOT = BOTTOM_Y + ROW_H;
---

<figure class="diagram not-content">
	<svg viewBox="0 0 880 486" role="img"
		aria-label="The layers of noeira, top to bottom: drivers and deployment; learning (RL, world models, imitation, VLAs, planners); deep learning and data; and at the bottom, side by side, simulation and tasks, and the real world — the robot's servo bus and cameras. The bottom layers are general-purpose libraries usable without any learning code.">
		<text x="20" y="30" class="dg-title dg-title--left">Layers, one compilation unit</text>
		<text x="20" y="52" class="dg-sub dg-sub--left">
			Generic traits let the compiler specialize the whole pipeline for the target device.
		</text>

		{/* the standalone bracket */}
		<path class="dg-edge dg-edge--cyan"
			d={`M 196 ${BRACKET_TOP} L 184 ${BRACKET_TOP} L 184 ${BRACKET_BOT} L 196 ${BRACKET_BOT}`} />
		<text x="20" y={(BRACKET_TOP + BRACKET_BOT) / 2 - 4} class="dg-sub dg-sub--left">
			usable without
		</text>
		<text x="20" y={(BRACKET_TOP + BRACKET_BOT) / 2 + 16} class="dg-sub dg-sub--left">
			any learning code
		</text>

		{
			LAYERS.map((layer, i) => (
				<g>
					<g class={`dg-node dg-node--${layer.tone}`}>
						<rect x="210" y={ROW_Y(i)} width="550" height={ROW_H} rx="9" />
					</g>
					<text x="230" y={ROW_Y(i) + 26} class="dg-title dg-title--left">
						{layer.name}
					</text>
					<text x="230" y={ROW_Y(i) + 48} class="dg-sub dg-sub--left">
						{layer.what}
					</text>
					<text x="740" y={ROW_Y(i) + 26} class={`dg-label dg-label--${layer.tone}`} text-anchor="end">
						{layer.pkg}
					</text>
				</g>
			))
		}

		{/* the bottom row: simulation beside the real world */}
		<g class="dg-node dg-node--cyan">
			<rect x="210" y={BOTTOM_Y} width="340" height={ROW_H} rx="9" />
		</g>
		<text x="230" y={BOTTOM_Y + 26} class="dg-title dg-title--left">Simulation and tasks</text>
		<text x="230" y={BOTTOM_Y + 48} class="dg-sub dg-sub--left">physics3d · physics2d · envs · tasks</text>

		<g class="dg-node dg-node--green">
			<rect x="560" y={BOTTOM_Y} width="200" height={ROW_H} rx="9" />
		</g>
		<text x="580" y={BOTTOM_Y + 26} class="dg-title dg-title--left">The real world</text>
		<text x="580" y={BOTTOM_Y + 48} class="dg-sub dg-sub--left">robot · vision</text>

		<text x="20" y="440" class="dg-sub dg-sub--left">
			Lower layers do not import the learning code — the page lists the two deliberate exceptions.
		</text>
		<text x="20" y="462" class="dg-sub dg-sub--left">
			The same model code runs against a simulated scene or a real arm.
		</text>
	</svg>

	<figcaption class="diagram__legend">
		<span class="diagram__key diagram__key--spark">learning-specific</span>
		<span class="diagram__key diagram__key--cyan">general-purpose, usable standalone</span>
		<span class="diagram__key diagram__key--green">hardware</span>
	</figcaption>
</figure>
